APP_NAME="Service Ops"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=service_ops
DB_USERNAME=service_ops
DB_PASSWORD=service_ops

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Telegram bot ---
# Токен получить у @BotFather
TELEGRAM_BOT_TOKEN=
# Случайная строка, которую Telegram обязан присылать в заголовке X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=
# Твой личный telegram_user_id (узнать у @userinfobot) — сидер выдаёт ему роль SUPERADMIN
TELEGRAM_OWNER_ID=

# Ключ для Internal API (заголовок X-Internal-Api-Key, ТЗ п.88) — приём заказов
# от CRM/сайта и обратная связь по ним. Сгенерируй, например, `openssl rand -hex 20`.
INTERNAL_API_KEY=

# Класс-адаптер для синка заказов во внешнюю CRM (ТЗ п.85-87). По умолчанию —
# LogCrmAdapter, который только логирует снимок заказа: реальной CRM ещё нет,
# и система обязана нормально работать без неё (см. vault/Решения.md). Когда
# появится Bitrix24/amoCRM/другая — сюда подставляется класс нового адаптера.
CRM_ADAPTER_CLASS=

# Диск для фото/видео заказов (ТЗ п.54 — приватное хранилище, не сам Telegram).
# local — папка на этом сервере (годится для разработки и небольшого продакшна).
# В проде на реальном потоке заказов — s3 (см. AWS_* выше; ENDPOINT указать на
# S3-совместимого провайдера в РФ, например Selectel или VK Cloud).
MEDIA_DISK_DRIVER=local

# Диск для бэкапов БД (ТЗ п.105). Можно указать другой bucket/регион, чем у медиа,
# через BACKUP_AWS_BUCKET — иначе просто использует общий AWS_BUCKET.
BACKUP_DISK_DRIVER=local

# --- Мониторинг (ТЗ п.104) ---
# Пусто — Sentry SDK молча ничего не отправляет (см. config/sentry.php), заводить
# реальный DSN нужно только перед продакшном.
SENTRY_LARAVEL_DSN=
